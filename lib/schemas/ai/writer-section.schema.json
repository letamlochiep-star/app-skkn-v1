{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WriterSectionResponse",
  "type": "object",
  "required": ["action", "promptNumber", "section", "warnings"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["draft_section", "revise_section"]
    },
    "promptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "section": {
      "type": "object",
      "required": ["title", "content", "usedFactKeys", "missingFactKeys"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "content": { "type": "string", "minLength": 20 },
        "usedFactKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missingFactKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidencePlaceholders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "referenceKeys": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
