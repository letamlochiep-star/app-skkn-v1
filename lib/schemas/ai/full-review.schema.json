{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FullReviewResponse",
  "type": "object",
  "required": [
    "action",
    "summary",
    "rubric",
    "mandatoryFixes",
    "qualityImprovements",
    "keepAsIs",
    "priorityRevisions",
    "warnings"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["review_full_document"]
    },
    "summary": {
      "type": "object",
      "required": ["overallAssessment", "strengths", "mainRisks"],
      "properties": {
        "overallAssessment": { "type": "string" },
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mainRisks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["criterion", "assessment", "strengths", "issues", "evidence", "recommendation"],
        "properties": {
          "criterion": { "type": "string" },
          "assessment": {
            "type": "string",
            "enum": ["STRONG", "ADEQUATE", "NEEDS_IMPROVEMENT", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE"]
          },
          "strengths": { "type": "string" },
          "issues": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mandatoryFixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description", "category", "severity"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "whyItMatters": { "type": "string" },
          "suggestedFix": { "type": "string" },
          "documentLocation": { "type": "string" },
          "requiredDataKeys": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "qualityImprovements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description", "category", "severity"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "whyItMatters": { "type": "string" },
          "suggestedFix": { "type": "string" },
          "documentLocation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "keepAsIs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description", "category", "severity"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "documentLocation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "priorityRevisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["priorityNumber", "problem", "whyItMatters", "recommendedChange", "documentLocation", "requiredEvidenceOrData"],
        "properties": {
          "priorityNumber": { "type": "integer", "minimum": 1, "maximum": 3 },
          "problem": { "type": "string", "minLength": 5 },
          "whyItMatters": { "type": "string", "minLength": 5 },
          "recommendedChange": { "type": "string", "minLength": 5 },
          "documentLocation": { "type": "string" },
          "requiredEvidenceOrData": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
