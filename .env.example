# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public (Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private (Server Service Role - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider API Keys (Server Only)
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# AI Routing Strategy
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini

# AI Models for Task Classification
AI_CLASSIFY_MODEL=gpt-4o-mini
AI_EXTRACT_MODEL=gpt-4o-mini
AI_DRAFT_MODEL=gpt-4o
AI_REVIEW_MODEL=gpt-4o
AI_FINALIZE_MODEL=gpt-4o
